{
    "name": "imap-handler",
    "version": "1.3.0",
    "description": "Parses and compiles IMAP commands",
    "main": "index.js",
    "files": [
        "index.js",
        "lib"
    ],
    "scripts": {
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "test": "npm run lint && npm run test:unit",
        "test:unit": "node --test test/*.js",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/imap-handler.git"
    },
    "bugs": {
        "url": "https://github.com/postalsys/imap-handler/issues"
    },
    "homepage": "https://github.com/postalsys/imap-handler#readme",
    "keywords": [
        "IMAP"
    ],
    "author": "Postal Systems OÜ",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint": "10.12.0",
        "globals": "17.13.0",
        "prettier": "3.9.9"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
